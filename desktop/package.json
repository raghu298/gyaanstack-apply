{
  "name": "gyaanstack-apply-desktop",
  "productName": "GyaanStack Apply",
  "desktopName": "gyaanstack-apply-desktop.desktop",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "GyaanStack Apply as a desktop app",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "prepare-server": "node scripts/prepare-server.mjs",
    "package:linux": "yarn build && electron-builder --linux --x64",
    "package:windows": "yarn build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/node": "^24",
    "electron": "45.4.1",
    "electron-builder": "^26",
    "typescript": "^5"
  },
  "dependenciesMeta": {
    "electron": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.1",
  "author": {
    "name": "GyaanStack Apply",
    "email": "hello@gyaanstack.com"
  },
  "homepage": "https://apply.gyaanstack.com"
}
