{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-lintignore"
  ],
  "ignore": [
    "design/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "prisma/seed.ts",
        "prisma7.config.ts",
        "docker/studio-proxy.mjs",
        "e2e/setup.ts"
      ],
      "ignoreDependencies": [
        "@prisma/client"
      ]
    },
    "desktop": {
      "entry": [
        "src/{main,preload,bar-preload}.ts",
        "scripts/*.mjs",
        "server-tools/*.mjs",
        "start/*.{js,css}",
        "bar/*.{js,css}"
      ],
      "ignoreDependencies": [
        "electron-builder"
      ],
      "ignoreBinaries": [
        "electron-builder"
      ],
      "ignoreUnresolved": [
        "./server.js"
      ]
    },
    "desktop/dev": {
      "entry": [
        "e2e/**/*.spec.ts",
        "test/**/*.ts"
      ],
      "ignoreBinaries": [
        "openssl",
        "xdotool"
      ]
    }
  }
}
